# 统一由 git 管理换行，避免跨平台 Agent 之间产生“整文件改动”噪音
* text=auto

*.ps1   text eol=lf
*.cmd   text eol=crlf
*.md    text eol=lf
*.hlsl  text eol=lf
*.sksl  text eol=lf
*.cpp   text eol=lf
*.h     text eol=lf
*.hpp   text eol=lf
*.mm    text eol=lf
*.metal text eol=lf
*.cmake text eol=lf

# 二进制资源不做文本转换
*.png  binary
*.jpg  binary
*.exr  binary
*.mp4  binary
