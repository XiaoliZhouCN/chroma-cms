{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 28,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "windows-x64",
            "hidden": true,
            "generator": "Visual Studio 18 2026",
            "architecture": {
                "value": "x64",
                "strategy": "set"
            },
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_CXX_STANDARD": "20"
            }
        },
        {
            "name": "windows-x64-debug",
            "inherits": "windows-x64",
            "displayName": "Windows x64 Debug",
            "cacheVariables": {
                "CMAKE_CONFIGURATION_TYPES": "Debug"
            }
        },
        {
            "name": "windows-x64-release",
            "inherits": "windows-x64",
            "displayName": "Windows x64 Release",
            "cacheVariables": {
                "CMAKE_CONFIGURATION_TYPES": "Release"
            }
        },
        {
            "name": "windows-x64-skia",
            "inherits": "windows-x64",
            "displayName": "Windows x64 + Skia (Release only)",
            "cacheVariables": {
                "CMAKE_CONFIGURATION_TYPES": "Release",
                "CHROMA_WITH_SKIA": "ON",
        "CHROMA_DEFAULT_BACKEND": "skia"
            }
        },
        {
            "name": "macos-arm64",
            "hidden": true,
            "displayName": "macOS (Ninja, Apple Silicon)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_OSX_ARCHITECTURES": "arm64",
                "CMAKE_OSX_DEPLOYMENT_TARGET": "13.0",
                "CMAKE_PREFIX_PATH": "$penv{QT_ROOT}"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "macos-arm64-debug",
            "inherits": "macos-arm64",
            "displayName": "macOS arm64 Debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "macos-arm64-release",
            "inherits": "macos-arm64",
            "displayName": "macOS arm64 Release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "macos-x64",
            "hidden": true,
            "displayName": "macOS (Ninja, Intel)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_OSX_ARCHITECTURES": "x86_64",
                "CMAKE_OSX_DEPLOYMENT_TARGET": "13.0",
                "CMAKE_PREFIX_PATH": "$penv{QT_ROOT}"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "macos-x64-debug",
            "inherits": "macos-x64",
            "displayName": "macOS x86_64 Debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "windows-x64-debug",
            "configurePreset": "windows-x64-debug",
            "configuration": "Debug"
        },
        {
            "name": "windows-x64-release",
            "configurePreset": "windows-x64-release",
            "configuration": "Release"
        },
        {
            "name": "windows-x64-skia",
            "configurePreset": "windows-x64-skia",
            "configuration": "Release"
        },
        {
            "name": "macos-arm64-debug",
            "configurePreset": "macos-arm64-debug"
        },
        {
            "name": "macos-arm64-release",
            "configurePreset": "macos-arm64-release"
        },
        {
            "name": "macos-x64-debug",
            "configurePreset": "macos-x64-debug"
        }
    ],
    "testPresets": [
        {
            "name": "windows-x64-debug",
            "configurePreset": "windows-x64-debug",
            "configuration": "Debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "windows-x64-release",
            "configurePreset": "windows-x64-release",
            "configuration": "Release",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "windows-x64-skia",
            "configurePreset": "windows-x64-skia",
            "configuration": "Release",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "macos-arm64-debug",
            "configurePreset": "macos-arm64-debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "macos-arm64-release",
            "configurePreset": "macos-arm64-release",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}